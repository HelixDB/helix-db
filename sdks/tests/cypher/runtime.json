{
  "schema_version": 1,
  "cases": [
    {
      "name": "scalar-values",
      "query": "RETURN $big AS big,$values AS values,$opaque AS opaque,$nan AS nan",
      "parameters": {
        "big": {
          "$type": "integer",
          "value": "9223372036854775807"
        },
        "values": [
          true,
          null,
          "café 🪄",
          {
            "minimum": {
              "$type": "integer",
              "value": "-9223372036854775808"
            }
          }
        ],
        "opaque": {
          "$type": "map",
          "value": {
            "$type": "integer",
            "value": "ordinary map"
          }
        },
        "nan": {
          "$type": "float",
          "value": "NaN"
        }
      },
      "expected": {
        "columns": ["big", "values", "opaque", "nan"],
        "rows": [
          [
            {
              "$type": "integer",
              "value": "9223372036854775807"
            },
            [
              true,
              null,
              "café 🪄",
              {
                "minimum": {
                  "$type": "integer",
                  "value": "-9223372036854775808"
                }
              }
            ],
            {
              "$type": "map",
              "value": {
                "$type": "integer",
                "value": "ordinary map"
              }
            },
            {
              "$type": "float",
              "value": "NaN"
            }
          ]
        ]
      }
    },
    {
      "name": "create",
      "query": "CREATE (a:CypherParity {key:'a',count:$big}),(b:CypherParity {key:'b'}),(a)-[r:CYPHER_PARITY {tag:'edge'}]->(b) RETURN labels(a) AS labels,type(r) AS type,a.count AS count,properties(b) AS properties",
      "parameters": {
        "big": {
          "$type": "integer",
          "value": "9223372036854775807"
        }
      },
      "expected": {
        "columns": ["labels", "type", "count", "properties"],
        "rows": [
          [
            ["CypherParity"],
            "CYPHER_PARITY",
            {
              "$type": "integer",
              "value": "9223372036854775807"
            },
            {
              "key": "b"
            }
          ]
        ]
      }
    },
    {
      "name": "graph-values",
      "query": "MATCH p=(a:CypherParity {key:'a'})-[r:CYPHER_PARITY]->(b:CypherParity {key:'b'}) RETURN a AS node,r AS relationship,p AS path",
      "normalize_graph_ids": true,
      "expected": {
        "columns": ["node", "relationship", "path"],
        "rows": [
          [
            {
              "$type": "node",
              "id": "node:a",
              "labels": ["CypherParity"],
              "properties": {
                "key": "a",
                "count": {
                  "$type": "integer",
                  "value": "9223372036854775807"
                }
              }
            },
            {
              "$type": "relationship",
              "id": "relationship:edge",
              "start": "node:a",
              "end": "node:b",
              "type": "CYPHER_PARITY",
              "properties": {
                "tag": "edge"
              }
            },
            {
              "$type": "path",
              "nodes": [
                {
                  "$type": "node",
                  "id": "node:a",
                  "labels": ["CypherParity"],
                  "properties": {
                    "key": "a",
                    "count": {
                      "$type": "integer",
                      "value": "9223372036854775807"
                    }
                  }
                },
                {
                  "$type": "node",
                  "id": "node:b",
                  "labels": ["CypherParity"],
                  "properties": {
                    "key": "b"
                  }
                }
              ],
              "relationships": [
                {
                  "$type": "relationship",
                  "id": "relationship:edge",
                  "start": "node:a",
                  "end": "node:b",
                  "type": "CYPHER_PARITY",
                  "properties": {
                    "tag": "edge"
                  }
                }
              ]
            }
          ]
        ]
      }
    },
    {
      "name": "delete-rollback",
      "query": "MATCH (a:CypherParity {key:'a'}) SET a.rollback=true DELETE a",
      "expected_error_detail": "DeleteConnectedNode",
      "expected_error_category": "ConstraintVerificationFailed",
      "expected_error_phase": "runtime"
    },
    {
      "name": "rollback-observation",
      "query": "MATCH (a:CypherParity {key:'a'}) RETURN a.rollback AS rollback,a.count AS count",
      "expected": {
        "columns": ["rollback", "count"],
        "rows": [
          [
            null,
            {
              "$type": "integer",
              "value": "9223372036854775807"
            }
          ]
        ]
      }
    },
    {
      "name": "update",
      "query": "MATCH (a:CypherParity {key:'a'}) SET a.count=$minimum,a += {extra:'changed',remove:null} REMOVE a.rollback RETURN properties(a) AS properties",
      "parameters": {
        "minimum": {
          "$type": "integer",
          "value": "-9223372036854775808"
        }
      },
      "expected": {
        "columns": ["properties"],
        "rows": [
          [
            {
              "key": "a",
              "count": {
                "$type": "integer",
                "value": "-9223372036854775808"
              },
              "extra": "changed"
            }
          ]
        ]
      }
    },
    {
      "name": "persistent-read",
      "query": "MATCH (a:CypherParity)-[r:CYPHER_PARITY]->(b:CypherParity) RETURN a.key AS source,b.key AS target,a.count AS count,type(r) AS type",
      "after_disk_reopen": true,
      "expected": {
        "columns": ["source", "target", "count", "type"],
        "rows": [
          [
            "a",
            "b",
            {
              "$type": "integer",
              "value": "-9223372036854775808"
            },
            "CYPHER_PARITY"
          ]
        ]
      }
    },
    {
      "name": "match-after-distinct",
      "query": "UNWIND ['a','a','b','missing',null] AS key WITH DISTINCT key OPTIONAL MATCH p=(a:CypherParity {key:key})-[:CYPHER_PARITY]->(b) RETURN key AS key,b.key AS target,length(p) AS length ORDER BY key LIMIT 10",
      "expected": {
        "columns": ["key", "target", "length"],
        "rows": [
          ["a", "b", 1],
          ["b", null, null],
          ["missing", null, null],
          [null, null, null]
        ]
      }
    },
    {
      "name": "mixed-aggregate-ordering",
      "query": "UNWIND $values AS x RETURN 1+sum(x) AS total ORDER BY 2-sum(x)",
      "parameters": {
        "values": [
          {
            "$type": "integer",
            "value": "9007199254740992"
          },
          1
        ]
      },
      "expected": {
        "columns": ["total"],
        "rows": [
          [
            {
              "$type": "integer",
              "value": "9007199254740994"
            }
          ]
        ]
      }
    },
    {
      "name": "aggregate-alias-shadowing",
      "query": "UNWIND [{g:0,x:2},{g:1,x:4},{g:0,x:3}] AS row WITH row.g AS g,row.x AS x RETURN g,sum(x) AS x ORDER BY x+sum(x) DESC,g",
      "expected": {
        "columns": ["g", "x"],
        "rows": [
          [0, 5],
          [1, 4]
        ]
      }
    },
    {
      "name": "mixed-empty-aggregation",
      "query": "UNWIND [] AS x RETURN 1+count(*) AS count,[sum(x),avg(x),min(x),max(x),collect(x)] AS values",
      "expected": {
        "columns": ["count", "values"],
        "rows": [[1, [0, null, null, null, []]]]
      }
    },
    {
      "name": "aggregate-error-rollback",
      "query": "MATCH (a:CypherParity {key:'a'}) SET a.aggregate_marker=true WITH 0 AS zero RETURN CASE WHEN false THEN sum(1/zero) ELSE 0 END AS result",
      "expected_error_detail": "DivisionByZero",
      "expected_error_category": "ArithmeticError",
      "expected_error_phase": "runtime"
    },
    {
      "name": "aggregate-rollback-observation",
      "query": "MATCH (a:CypherParity {key:'a'}) RETURN a.aggregate_marker AS marker",
      "expected": {
        "columns": ["marker"],
        "rows": [[null]]
      }
    },
    {
      "name": "renamed-node-ordering",
      "query": "MATCH (n:CypherParity) WITH DISTINCT n AS node ORDER BY n:CypherParity,n.key DESC RETURN collect(node.key) AS keys",
      "expected": {
        "columns": ["keys"],
        "rows": [[["b", "a"]]]
      }
    },
    {
      "name": "detach-delete",
      "query": "MATCH (n:CypherParity) DETACH DELETE n RETURN count(*) AS deleted",
      "expected": {
        "columns": ["deleted"],
        "rows": [[2]]
      }
    },
    {
      "name": "deleted-observation",
      "query": "MATCH (n:CypherParity) RETURN count(*) AS remaining",
      "expected": {
        "columns": ["remaining"],
        "rows": [[0]]
      }
    }
  ]
}
