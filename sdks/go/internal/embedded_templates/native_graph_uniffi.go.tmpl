type uniffiGraph struct {
	graph            *native.NativeGraph
	externalIdentity bool
}

type externalIdentityEnvelope struct {
	Payload externalIdentityPayload `json:"__helix_external_id_v1"`
}

type externalIdentityPayload struct {
	Type  string          `json:"type"`
	Value json.RawMessage `json:"value"`
}

type edgeIdentity struct {
	StoredID          string `json:"stored_id"`
	ReverseGeneration uint64 `json:"reverse_generation"`
}

func nativeGraphAvailable() bool { return true }

func graphFromQueryResponse(spec graphLoadSpec, response []byte) (graphBackend, error) {
	graph, err := native.GraphFromQueryResponse(nativeGraphSpec(spec), response)
	if err != nil {
		return nil, err
	}
	return &uniffiGraph{graph: graph, externalIdentity: spec.ExternalIdentity}, nil
}

func nativeGraphSpec(spec graphLoadSpec) native.NativeGraphLoadSpec {
	kind := native.NativeGraphKindDiGraph
	if spec.Direction == GraphUndirected {
		kind = native.NativeGraphKindGraph
	}
	var edgeKeyIdentity *native.NativeIdentityEncoding
	if spec.GraphifyEdgeKey {
		encoding := native.NativeIdentityEncodingScalar
		edgeKeyIdentity = &encoding
		if spec.Direction == GraphUndirected {
			kind = native.NativeGraphKindMultiGraph
		} else {
			kind = native.NativeGraphKindMultiDiGraph
		}
	}
	return native.NativeGraphLoadSpec{
		Kind:            kind,
		NodeIdentity:    native.NativeIdentityEncodingScalar,
		EdgeKeyIdentity: edgeKeyIdentity,
		NodeLimit:       spec.NodeLimit,
		EdgeLimit:       spec.EdgeLimit,
	}
}

