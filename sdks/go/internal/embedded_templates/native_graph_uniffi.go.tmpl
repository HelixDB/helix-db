func (g *uniffiGraph) Compose(right graphBackend) (graphBackend, error) {
	other, ok := right.(*uniffiGraph)
	if !ok {
		return nil, errors.New("helix: graphs use different native binding backends")
	}
	if g.externalIdentity != other.externalIdentity {
		return nil, errors.New("helix: graphs use different node identity contracts")
	}
	value, err := g.graph.Compose(other.graph)
	if err != nil {
		return nil, err
	}
	return &uniffiGraph{graph: value, externalIdentity: g.externalIdentity}, nil
}
func (g *uniffiGraph) Relabel(mapping map[string]string) (graphBackend, error) {
	keys := make([]string, 0, len(mapping))
	for key := range mapping {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	values := make([]native.NativeRelabel, len(keys))
	for i, key := range keys {
		from, err := nativeExternalID(key, g.externalIdentity)
		if err != nil {
			return nil, err
		}
		to, err := nativeExternalID(mapping[key], g.externalIdentity)
		if err != nil {
			return nil, err
		}
		values[i] = native.NativeRelabel{From: from, To: to}
	}
	result, err := g.graph.Relabel(values)
	if err != nil {
		return nil, err
	}
	return &uniffiGraph{graph: result, externalIdentity: g.externalIdentity}, nil
}

// nativeExternalID preserves the Go string graph API in the binding's tagged identity envelope.
func nativeExternalID(value string, externalIdentity bool) (native.NativeExternalId, error) {
	kind := "string"
	if !externalIdentity {
		parsed, err := strconv.ParseUint(value, 10, 64)
		if err != nil || strconv.FormatUint(parsed, 10) != value {
			return native.NativeExternalId{}, fmt.Errorf("helix: invalid internal node id %q", value)
		}
		kind = "integer"
	}
	encodedValue, err := json.Marshal(value)
	if err != nil {
		return native.NativeExternalId{}, fmt.Errorf("helix: encode node identity: %w", err)
	}
	encoded, err := json.Marshal(externalIdentityEnvelope{Payload: externalIdentityPayload{
		Type:  kind,
		Value: encodedValue,
	}})
	if err != nil {
		return native.NativeExternalId{}, fmt.Errorf("helix: encode node identity: %w", err)
	}
	return native.NativeExternalId{Encoded: encoded}, nil
}

func nativeExternalIDs(values []string, externalIdentity bool) ([]native.NativeExternalId, error) {
	result := make([]native.NativeExternalId, len(values))
	for i, value := range values {
		encoded, err := nativeExternalID(value, externalIdentity)
		if err != nil {
			return nil, err
		}
		result[i] = encoded
	}
	return result, nil
}

// externalID decodes only identity variants representable by the current Go string API.
func externalID(value native.NativeExternalId) (string, error) {
	var envelope externalIdentityEnvelope
	if err := json.Unmarshal(value.Encoded, &envelope); err != nil {
		return "", fmt.Errorf("helix: decode node identity: %w", err)
	}
	canonical, err := json.Marshal(envelope)
	if err != nil || !bytes.Equal(canonical, value.Encoded) {
		return "", errors.New("helix: node identity is not canonically encoded")
	}
	if envelope.Payload.Type != "string" && envelope.Payload.Type != "integer" {
		return "", fmt.Errorf("helix: Go string graph API cannot represent %s node identity", envelope.Payload.Type)
	}
	var decoded string
	if err := json.Unmarshal(envelope.Payload.Value, &decoded); err != nil {
		return "", fmt.Errorf("helix: decode node identity value: %w", err)
	}
	return decoded, nil
}

func externalIDs(values []native.NativeExternalId) ([]string, error) {
	result := make([]string, len(values))
	for i, value := range values {
		decoded, err := externalID(value)
		if err != nil {
			return nil, err
		}
		result[i] = decoded
	}
	return result, nil
}

func optionalExternalID(value *native.NativeExternalId) (*string, error) {
	if value == nil {
		return nil, nil
	}
	decoded, err := externalID(*value)
	if err != nil {
		return nil, err
	}
	return &decoded, nil
}

// nativeEdgeID accepts stored IDs and the canonical structural form returned for reversed edges.
func nativeEdgeID(value string) (native.NativeEdgeId, error) {
	identity := edgeIdentity{StoredID: value}
	var structural edgeIdentity
	if err := json.Unmarshal([]byte(value), &structural); err == nil && structural.StoredID != "" {
		canonical, err := json.Marshal(structural)
		if err == nil && string(canonical) == value {
			identity = structural
		}
	}
	if identity.StoredID == "" {
		return native.NativeEdgeId{}, errors.New("helix: edge id must not be empty")
	}
	encoded, err := json.Marshal(identity)
	if err != nil {
		return native.NativeEdgeId{}, fmt.Errorf("helix: encode edge identity: %w", err)
	}
	return native.NativeEdgeId{Encoded: encoded}, nil
}

// edgeID keeps original IDs compact while retaining reversible structural identity.
func edgeID(value native.NativeEdgeId) (string, error) {
	var identity edgeIdentity
	if err := json.Unmarshal(value.Encoded, &identity); err != nil {
		return "", fmt.Errorf("helix: decode edge identity: %w", err)
	}
	canonical, err := json.Marshal(identity)
	if err != nil || identity.StoredID == "" || !bytes.Equal(canonical, value.Encoded) {
		return "", errors.New("helix: edge identity is not canonically encoded")
	}
	if identity.ReverseGeneration == 0 {
		return identity.StoredID, nil
	}
	return string(canonical), nil
}

func edgeIDs(values []native.NativeEdgeId) ([]string, error) {
	result := make([]string, len(values))
	for i, value := range values {
		decoded, err := edgeID(value)
		if err != nil {
			return nil, err
		}
		result[i] = decoded
	}
	return result, nil
}

func nativeDirection(value TraversalDirection) (native.NativeTraversalDirection, error) {
	switch value {
	case 0, TraversalBoth:
		return native.NativeTraversalDirectionBoth, nil
	case TraversalOut:
		return native.NativeTraversalDirectionOut, nil
	case TraversalIn:
		return native.NativeTraversalDirectionIn, nil
	default:
		return 0, fmt.Errorf("helix: invalid traversal direction %d", value)
	}
}
func nativeDegree(value DegreeKind) (native.NativeDegreeKind, error) {
	switch value {
	case 0, DegreeTotal:
		return native.NativeDegreeKindTotal, nil
	case DegreeIn:
		return native.NativeDegreeKindIn, nil
	case DegreeOut:
		return native.NativeDegreeKindOut, nil
	default:
		return 0, fmt.Errorf("helix: invalid degree kind %d", value)
	}
}
