func graphNode(value native.NativeGraphNode) (GraphNode, error) {
	id, err := externalID(value.Id)
	return GraphNode{ID: id, Label: value.Label, AttributesJSON: value.AttributesJson}, err
}
func graphEdge(value native.NativeGraphEdge) (GraphEdge, error) {
	id, err := edgeID(value.Id)
	if err != nil {
		return GraphEdge{}, err
	}
	graphifyKey, err := optionalExternalID(value.GraphifyKey)
	if err != nil {
		return GraphEdge{}, err
	}
	source, err := externalID(value.Source)
	if err != nil {
		return GraphEdge{}, err
	}
	target, err := externalID(value.Target)
	if err != nil {
		return GraphEdge{}, err
	}
	return GraphEdge{ID: id, GraphifyKey: graphifyKey, Source: source, Target: target, Label: value.Label, Weight: value.Weight, AttributesJSON: value.AttributesJson}, nil
}

